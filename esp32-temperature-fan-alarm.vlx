{
  "format": "velxio-project",
  "version": 1,
  "exportedAt": "2026-10-06T03:56:14.157Z",
  "name": "esp32-temperature-fan-alarm",
  "boards": [
    {
      "id": "esp32",
      "boardKind": "esp32",
      "x": 50,
      "y": 50,
      "activeFileGroupId": "group-esp32",
      "languageMode": "arduino",
      "serialBaudRate": 0
    }
  ],
  "fileGroups": {
    "group-esp32": [
      {
        "name": "sketch.ino",
        "content": "#define NTC_PIN     34\n#define RELAY_PIN   26\n#define BUZZER_PIN  25\n\n// Temperature limit\n#define HIGH_TEMP   50.0\n\n// NTC parameters\n#define SERIES_RESISTOR     10000.0\n#define NOMINAL_RESISTANCE  10000.0\n#define NOMINAL_TEMP       25.0\n#define BETA_COEFFICIENT   3950.0\n\nvoid setup()\n{\n  Serial.begin(115200);\n\n  pinMode(RELAY_PIN, OUTPUT);\n  pinMode(BUZZER_PIN, OUTPUT);\n\n  digitalWrite(RELAY_PIN, LOW);\n  noTone(BUZZER_PIN);\n\n  analogReadResolution(12);\n}\n\nvoid loop()\n{\n  int adcValue = analogRead(NTC_PIN);\n\n  // Prevent division by zero\n  if (adcValue == 0)\n    adcValue = 1;\n\n  // Convert ADC value to resistance\n  float resistance = SERIES_RESISTOR *\n                     ((4095.0 / adcValue) - 1.0);\n\n  // Calculate temperature\n  float steinhart;\n\n  steinhart = resistance / NOMINAL_RESISTANCE;\n  steinhart = log(steinhart);\n  steinhart /= BETA_COEFFICIENT;\n  steinhart += 1.0 / (NOMINAL_TEMP + 273.15);\n  steinhart = 1.0 / steinhart;\n  steinhart -= 273.15;\n\n  Serial.print(\"Temperature: \");\n  Serial.print(steinhart);\n  Serial.println(\" °C\");\n\n  // HIGH TEMPERATURE\n  if (steinhart >= HIGH_TEMP)\n  {\n    // Turn ON fan\n    digitalWrite(RELAY_PIN, HIGH);\n\n    // Buzzer ON\n    tone(BUZZER_PIN, 2000);\n\n    Serial.println(\"WARNING! HIGH TEMPERATURE\");\n    Serial.println(\"Fan ON\");\n    Serial.println(\"Buzzer ON\");\n\n    delay(500);\n\n    // Buzzer OFF\n    noTone(BUZZER_PIN);\n\n    delay(500);\n  }\n\n  // NORMAL TEMPERATURE\n  else\n  {\n    digitalWrite(RELAY_PIN, LOW);\n    noTone(BUZZER_PIN);\n\n    Serial.println(\"Temperature Normal\");\n    Serial.println(\"Fan OFF\");\n    Serial.println(\"Buzzer OFF\");\n\n    delay(1000);\n  }\n}"
      }
    ]
  },
